{
  "name": "omni-skills-forge",
  "version": "2.3.0",
  "description": "Pick coding skills for the task and project folder. Manage per-agent preferences and see which skills were delivered through local prompt hooks or MCP.",
  "main": "src/index.js",
  "bin": {
    "omni-skills-forge": "bin/cli.js",
    "osf": "bin/cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "node bin/cli.js",
    "test": "node --test",
    "generate": "node scripts/generate-skills.js",
    "build-registry": "node scripts/build-registry.js",
    "prepublishOnly": "node scripts/build-registry.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "registry/",
    "scripts/build-registry.js",
    "scripts/measure-workspace.mjs",
    "test/",
    "README.md",
    "LICENSE",
    "assets/",
    "docs/"
  ],
  "keywords": [
    "ai",
    "skills",
    "claude",
    "kilo",
    "cline",
    "opencode",
    "cursor",
    "windsurf",
    "ai-agent",
    "coding-assistant",
    "prompt-engineering",
    "developer-tools",
    "cli",
    "skill-library",
    "ai-tools",
    "agentic",
    "mcp-server",
    "context-engineering",
    "skill-selection",
    "agent-skills",
    "codex"
  ],
  "author": {
    "name": "Ihtisham",
    "url": "https://github.com/theihtishaam"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theihtishaam/omni-skills-forge.git"
  },
  "bugs": {
    "url": "https://github.com/theihtishaam/omni-skills-forge/issues"
  },
  "homepage": "https://github.com/theihtishaam/omni-skills-forge#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1",
    "cli-table3": "^0.6.4",
    "commander": "^12.0.0",
    "boxen": "^7.1.1",
    "gradient-string": "^2.0.2",
    "open": "^10.0.3",
    "cli-progress": "^3.12.0"
  }
}
